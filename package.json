{
  "name": "music-pulse-interstellar-warp",
  "private": true,
  "version": "2.3.1",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "qa": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "science:bootstrap": "bash scientific/bootstrap_science.sh",
    "science:assets": "python3 science/build_astronomy_assets.py",
    "celestia:bootstrap": "bash scientific/celestia/bootstrap_celestia.sh",
    "qa:science": "python3 -m compileall science scientific && python3 scientific/verify_science_stack.py",
    "worker:dev": "wrangler dev --config ./wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config ./wrangler.jsonc",
    "deploy": "npm run worker:deploy"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "postprocessing": "6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1",
    "three-nebula": "12.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "4.122.0"
  }
}
