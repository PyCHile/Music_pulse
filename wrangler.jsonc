{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "music-pulse",
  "main": "worker/src/index-v2.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://pychile.github.io"
  },
  "secrets": {
    "required": ["OPENROUTER_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "URUX_RATE_LIMITER",
      "namespace_id": "12082601",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
